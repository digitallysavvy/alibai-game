{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint lib/scenarios lib/server scripts tests app/api",
    "test": "node --conditions=react-server --import tsx --test tests/unit.test.ts tests/provider-facts.test.ts tests/live-transcript.test.ts tests/lead-matching.test.ts tests/session-flow.test.ts",
    "test:db": "node --import tsx --test tests/db.test.ts",
    "scenarios:generate": "node --env-file-if-exists=.env.local --import tsx scripts/scenarios/generate.ts",
    "scenarios:validate": "node --env-file-if-exists=.env.local --import tsx scripts/scenarios/validate.ts",
    "scenarios:seed": "node --env-file-if-exists=.env.local --import tsx scripts/scenarios/generate.ts --fixtures --count 16",
    "scenarios:publish": "node --env-file-if-exists=.env.local --import tsx scripts/scenarios/publish.ts",
    "agents:cleanup": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/cleanup-agents.ts",
    "agents:cleanup:watch": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/cleanup-agents.ts --watch",
    "data:build": "node --import tsx scripts/data/build.ts",
    "data:setup": "supabase db push --remote --include-seed",
    "data:setup:local": "supabase db push --include-seed"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@vercel/analytics": "1.6.1",
    "agora-agent-client-toolkit": "2.10.0",
    "agora-agents": "2.11.0",
    "agora-rtc-sdk-ng": "4.24.3",
    "agora-rtm": "2.3.0",
    "agora-token": "2.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.16.0",
    "next": "16.4.3",
    "react": "^19",
    "react-dom": "^19",
    "server-only": "0.0.1",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "typescript-eslint": "8.72.0"
  }
}
